{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@problems/*": ["practice_problems/*"],
      "@answers/*": ["practice_problem_answers/*"]
    },
    "types": ["node"]
  },
  "include": ["practice_problems", "practice_problem_answers", "tests", "vitest.config.ts"]
}
